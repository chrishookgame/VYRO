# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI server-side API key
OPENAI_API_KEY=

# Development-only fallback.
# Keep false in production.
VYRO_AI_MOCK_FALLBACK=false
